# Build outputs and IDE state
build/
build_debug/
# Any other local build tree (build_qt/, build-evervale/, ...): they can hold
# tens of thousands of files and only slow every status/add down.
build*/
out/
bin/
# Tool and harness scratch directories.
.site-uploader/
.dsh-acl-recovery/
__pycache__/
Debug/
Release/
x64/
x86/
Obj/
.vs/
.vscode/
*.user
*.sln
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.obj
*.o
*.ilk
*.pch
*.idb
*.pdb
*.gch

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json

# Engine runtime data (per-project, regenerated)
*/Cache/*
*/Logs/*
*/Saved/*
*/Temp/*
*/Intermediate/*
*/DerivedData/*
# A game project's built binaries and test/QA captures (screenshots, videos,
# animation previews) are regenerated output, not source.
**/Binaries/
**/QA/
**/Intermediate/

# Misc
imgui.ini
*.aesc
.claude/
.DS_Store
Thumbs.db
*.log
*.tmp
