{
    // The dedicated server's config (docs/manual/15-dedicated-server.md).
    // The command line overrides every key; AETHER_SERVER_PASSWORD overrides "password",
    // AETHER_SERVER_TOKEN_SECRET overrides "token_secret".
    "name": "Aether dedicated server",
    "port": 7777,
    "max_players": 8,
    "password": "",
    "build_id": 1,
    // Join tokens: set an issuer secret (or AETHER_SERVER_TOKEN_SECRET) to require signed tokens.
    "token_secret": "",
    "require_token": true,
    "scene": "",
    "paks": ["Paks"],
    "tick_rate": 30,
    "log_file": "logs/server.log",
    "log_level": "info",
    "replicate_scene": true,
    "max_runtime": 0,
    "quit_when_empty": false,
    "status_interval": 10,
    // LAN discovery (aether_netclient --discover) on a second UDP port.
    "lan_advertise": true,
    "lan_port": 7778,
    // A network profile capture (JSON lines), e.g. "logs/profile.jsonl"; empty: none.
    "profile": "",
    "profile_interval": 1
}
